<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>کارگاه تراشکاری و جوشکاری | خدمات صنعتی</title>

  <meta name="description" content="ارائه خدمات تراشکاری، جوشکاری و ساخت قطعات صنعتی">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Tahoma, Arial, sans-serif;
      background: #f3f4f6;
      color: #222;
      line-height: 1.9;
    }

    header {
      background: linear-gradient(135deg, #111827, #374151);
      color: white;
      text-align: center;
      padding: 65px 20px;
    }

    header h1 {
      font-size: 32px;
      margin-bottom: 15px;
    }

    header p {
      font-size: 18px;
      color: #e5e7eb;
    }

    .btn {
      display: inline-block;
      margin-top: 25px;
      padding: 13px 28px;
      background: #f59e0b;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
    }

    section {
      max-width: 1000px;
      margin: auto;
      padding: 45px 20px;
    }

    section h2 {
      text-align: center;
      margin-bottom: 25px;
      color: #111827;
      font-size: 27px;
    }

    .box {
      background: white;
      padding: 28px;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0,0,0,.08);
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 28px 20px;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 3px 12px rgba(0,0,0,.08);
    }

    .card h3 {
      color: #d97706;
      margin-bottom: 10px;
      font-size: 21px;
    }

    .contact {
      background: #111827;
      color: white;
      text-align: center;
      border-radius: 12px;
      padding: 40px 20px;
    }

    .contact h2 {
      color: white;
    }

    .phone {
      display: inline-block;
